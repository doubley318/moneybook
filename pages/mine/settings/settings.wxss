page {
  min-height: 100vh;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.settings-page {
  min-height: 100vh;
  padding: 56rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.setting-section {
  margin-bottom: 34rpx;
}

.section-title {
  margin: 0 0 12rpx 14rpx;
  color: #7f7973;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 36rpx;
}

.setting-card {
  overflow: hidden;
  border: 2rpx solid #d4c8b8;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.72);
  box-sizing: border-box;
}

.setting-row {
  min-height: 86rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 44rpx;
  border-bottom: 1rpx solid #d7cec2;
  color: #1f1b18;
  font-size: 28rpx;
  font-weight: 500;
  box-sizing: border-box;
}

.setting-row:last-child {
  border-bottom: 0;
}

.row-arrow {
  width: 40rpx;
  height: 40rpx;
  flex: none;
  position: relative;
}

.row-arrow::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 7rpx;
  width: 20rpx;
  height: 20rpx;
  border-right: 4rpx solid #b4aea8;
  border-top: 4rpx solid #b4aea8;
  transform: rotate(45deg);
  box-sizing: border-box;
}

.tap-active {
  opacity: 0.68;
}

.dialog-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(44, 36, 28, 0.28);
  z-index: 100;
}

.clear-dialog {
  width: 600rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #fffdf9;
  box-shadow: 0 18rpx 42rpx rgba(44, 36, 28, 0.2);
}

.dialog-title {
  padding: 38rpx 42rpx 16rpx;
  color: #111111;
  font-size: 34rpx;
  font-weight: 700;
  text-align: center;
}

.dialog-text {
  padding: 0 46rpx 36rpx;
  color: #6f6861;
  font-size: 26rpx;
  line-height: 40rpx;
  text-align: center;
}

.dialog-actions {
  display: flex;
  border-top: 1rpx solid #eadfce;
}

.dialog-button {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 29rpx;
  font-weight: 600;
}

.dialog-button + .dialog-button {
  border-left: 1rpx solid #eadfce;
}

.dialog-button.cancel {
  color: #6f6861;
}

.dialog-button.confirm {
  color: #c52e2b;
}
