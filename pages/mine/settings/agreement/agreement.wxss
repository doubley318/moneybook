page {
  height: 100vh;
  overflow: hidden;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.agreement-page {
  height: calc(100vh - 94px);
  overflow: hidden;
  box-sizing: border-box;
}

.agreement-scroll {
  height: 100%;
}

.agreement-card {
  margin: 56rpx 30rpx 0;
  padding: 36rpx 34rpx 44rpx;
  border: 2rpx solid #d4c8b8;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-sizing: border-box;
}

.agreement-bottom-space {
  height: 140rpx;
}

.agreement-title {
  color: #111111;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 50rpx;
  text-align: center;
}

.agreement-date {
  margin-top: 14rpx;
  color: #7f7973;
  font-size: 24rpx;
  line-height: 36rpx;
  text-align: center;
}

.section {
  margin-top: 34rpx;
}

.section-title {
  color: #1f1b18;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.paragraph {
  margin-top: 14rpx;
  color: #3d3833;
  font-size: 27rpx;
  font-weight: 400;
  line-height: 44rpx;
  text-align: justify;
}
