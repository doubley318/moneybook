page {
  min-height: 100vh;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.profile-edit-page {
  min-height: 100vh;
  padding: 116rpx 30rpx 80rpx;
  box-sizing: border-box;
}

.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-wrap {
  width: 176rpx;
  height: 176rpx;
  position: relative;
}

.avatar-circle {
  width: 176rpx;
  height: 176rpx;
  overflow: hidden;
  border: 2rpx solid #d4c8b8;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.42);
  box-sizing: border-box;
}

.avatar-image {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-camera {
  position: absolute;
  right: 2rpx;
  bottom: 6rpx;
  width: 44rpx;
  height: 44rpx;
}

.form-section {
  width: 600rpx;
  margin-top: 52rpx;
  margin-left: auto;
  margin-right: auto;
}

.field-block {
  margin-bottom: 38rpx;
}

.field-label {
  color: #1f1b18;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 40rpx;
}

.nickname-input,
.phone-box {
  width: 100%;
  height: 92rpx;
  margin-top: 18rpx;
  border: 2rpx solid #d4c8b8;
  border-radius: 28rpx;
  color: #111111;
  background: rgba(255, 255, 255, 0.72);
  font-size: 28rpx;
  box-sizing: border-box;
}

.nickname-input {
  padding: 0 34rpx;
  text-align: center;
}

.phone-box {
  display: flex;
  align-items: center;
  padding: 0 22rpx 0 34rpx;
}

.phone-icon {
  width: 36rpx;
  height: 36rpx;
  flex: none;
  margin-right: 46rpx;
  position: relative;
  transform: rotate(-18deg);
}

.phone-icon::before {
  content: "";
  position: absolute;
  left: 8rpx;
  top: 2rpx;
  width: 20rpx;
  height: 32rpx;
  border: 5rpx solid #111111;
  border-top-width: 8rpx;
  border-bottom-width: 8rpx;
  border-radius: 12rpx;
  box-sizing: border-box;
}

.phone-number {
  flex: 1;
  min-width: 0;
  color: #1f1b18;
  font-size: 28rpx;
  line-height: 40rpx;
  white-space: nowrap;
}

.unbind-button {
  width: 74rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  border: 2rpx solid #d4c8b8;
  border-radius: 14rpx;
  color: #1f1b18;
  background: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  box-sizing: border-box;
}

.save-button {
  width: 520rpx;
  height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28rpx;
  margin: 120rpx auto 0;
  border: 2rpx solid #d4c8b8;
  border-radius: 46rpx;
  color: #111111;
  background: rgba(255, 255, 255, 0.72);
  font-size: 32rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.save-icon {
  width: 34rpx;
  height: 34rpx;
  flex: none;
  display: block;
}

.tap-active {
  opacity: 0.68;
}
