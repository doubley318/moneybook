page {
  height: 100vh;
  overflow: hidden;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.trash-page {
  height: calc(100vh - 94px);
  overflow: hidden;
  box-sizing: border-box;
  position: relative;
}

.trash-scroll {
  height: 100%;
  padding: 70rpx 30rpx 0;
  box-sizing: border-box;
}

.trash-card {
  padding: 34rpx 0 16rpx;
  border: 2rpx solid #d4c8b8;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-sizing: border-box;
}

.trash-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx;
}

.trash-title {
  color: #1f1b18;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.trash-subtitle {
  margin-top: 8rpx;
  margin-left: 28rpx;
  margin-right: 28rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #e7dccc;
  color: #8a8279;
  font-size: 24rpx;
  line-height: 34rpx;
}

.trash-list.empty {
  min-height: 286rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trash-list.empty record-group-list {
  width: 100%;
}

.trash-list record-group-list {
  --record-list-padding-bottom: 22rpx;
}

.trash-bottom-space {
  height: 190rpx;
}

.manage-button {
  min-width: 88rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b6840;
  font-size: 26rpx;
  font-weight: 500;
}

.manage-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(112rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx env(safe-area-inset-bottom);
  border-top: 1rpx solid #eadfce;
  background: rgba(255, 253, 249, 0.96);
  box-shadow: 0 -10rpx 28rpx rgba(122, 88, 44, 0.1);
  box-sizing: border-box;
  z-index: 60;
}

.select-all {
  display: flex;
  align-items: center;
  gap: 14rpx;
  color: #1f1b18;
  font-size: 28rpx;
  line-height: 40rpx;
}

.select-dot {
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid #c9bbaa;
  border-radius: 50%;
  background: #ffffff;
  box-sizing: border-box;
}

.select-dot view {
  width: 19rpx;
  height: 19rpx;
  display: none;
  border-radius: 50%;
  background: #c79b65;
}

.select-dot.checked {
  border-color: #c79b65;
}

.select-dot.checked view {
  display: block;
}

.manage-actions {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.manage-action {
  min-width: 136rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 32rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-sizing: border-box;
}

.manage-action.restore {
  color: #2d7a45;
  background: #e8f2e9;
}

.manage-action.delete {
  color: #ffffff;
  background: #c52e2b;
}

.manage-action.disabled {
  opacity: 0.55;
}
