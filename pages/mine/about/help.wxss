page {
  height: 100vh;
  overflow: hidden;
  color: #111111;
  background:
    radial-gradient(circle at 14% 0%, rgba(221, 198, 161, 0.18), transparent 34%),
    linear-gradient(180deg, #fbf5ec 0%, #f8f0e6 100%);
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Helvetica Neue", Arial, sans-serif;
}

.help-page {
  height: calc(100vh - 94px);
  overflow: hidden;
  box-sizing: border-box;
}

.help-scroll {
  height: 100%;
  padding: 70rpx 30rpx 0;
  box-sizing: border-box;
}

.help-card {
  padding: 34rpx;
  border: 2rpx solid #d4c8b8;
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.76);
  box-sizing: border-box;
}

.intro-card {
  display: flex;
  align-items: center;
  gap: 22rpx;
}

.intro-icon {
  width: 64rpx;
  height: 64rpx;
  flex: none;
}

.help-card-title {
  flex: 1;
  color: #1f1b18;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.operation-card,
.faq-card {
  margin-top: 28rpx;
}

.help-bottom-space {
  height: 140rpx;
}

.help-section-title {
  color: #1f1b18;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
}

.operation-item,
.faq-item {
  margin-top: 22rpx;
  padding: 26rpx 24rpx;
  border: 1rpx solid rgba(212, 200, 184, 0.68);
  border-radius: 22rpx;
  background: #fbf5ec;
  box-sizing: border-box;
}

.operation-title {
  color: #1f1b18;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.operation-step {
  margin-top: 10rpx;
  color: #4a433d;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 40rpx;
}

.faq-question {
  color: #1f1b18;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 40rpx;
}

.faq-answer {
  margin-top: 10rpx;
  color: #4a433d;
  font-size: 25rpx;
  font-weight: 400;
  line-height: 40rpx;
}
